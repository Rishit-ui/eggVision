# Database
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=eggvision
DATABASE_URL=postgresql+asyncpg://eggvision:replace-with-a-unique-local-password@localhost:5432/eggvision

# Redis
REDIS_URL=redis://localhost:6379/0

# S3/MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=eggvision
S3_ACCESS_KEY=replace-with-a-non-production-access-key
S3_SECRET_KEY=replace-with-a-non-production-secret-key
MINIO_ROOT_USER=replace-with-a-non-production-user
MINIO_ROOT_PASSWORD=replace-with-a-strong-non-production-password

# JWT
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ML
MODEL_PATH=./ml/models/
INFERENCE_DEVICE=cpu

# App
APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
